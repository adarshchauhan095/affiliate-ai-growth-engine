# ================================================================
# AI AFFILIATE GROWTH ENGINE - ENVIRONMENT CONFIGURATION
# ================================================================
# Copy this file to .env and populate your secure credentials.
# NEVER commit .env to source control!

# --- CORE SYSTEM SETTINGS ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
PORT=8000
HOST=127.0.0.1
APPROVAL_MODE=SEMI_AUTOMATIC   # MANUAL, SEMI_AUTOMATIC, AUTONOMOUS

# --- AFFILIATE SETTINGS ---
AMAZON_ASSOCIATE_TAG=mybudgetdeal9-21
AMAZON_MARKETPLACE=IN           # IN, US, UK, DE, etc.
DISCOVERY_PROVIDER=seed_catalog # seed_catalog, manual_url, or amazon_paapi (when 3 sales completed)

# --- AMAZON PA-API (Leave blank until 3 qualifying sales are achieved) ---
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=

# --- LOCAL STORAGE PATHS ---
STORAGE_BASE_DIR=./storage
MEDIA_RENDER_DIR=./storage/media/renders
MEDIA_TEMP_DIR=./storage/media/temp

# --- AI PROVIDERS (Zero-cost local fallback active by default) ---
AI_PROVIDER=local_template      # local_template, gemini_free, groq, or ollama
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_HOST=http://localhost:11434

# --- FIREBASE (Optional for local development / SQLite fallback active) ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# --- SOCIAL PLATFORMS (Populate when activating live publishing) ---
# Instagram / Facebook (Meta Graph API)
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Pinterest API v5
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# GitHub Pages Catalog Deployment
GITHUB_TOKEN=
GITHUB_REPO=adarshchauhan095/my-budget-deal-99
